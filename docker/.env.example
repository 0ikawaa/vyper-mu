# ============================================
#  Configuracion del servidor MU Online
#  Copiar a .env y cambiar TODOS los valores
# ============================================

# --- Base de datos PostgreSQL ---
# Cambiar por una password larga y aleatoria.
DB_PASSWORD=cambiar_esta_password

# --- Panel de administracion (http://localhost:8080) ---
# Si dejas estos vacios, el panel queda ABIERTO SIN LOGIN hasta que
# crees el primer usuario a mano. No los dejes vacios.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password_tambien

# Puerto del panel en tu maquina. Cambialo si el 8080 esta ocupado.
ADMIN_PORT=8080

# --- Resolucion de IP para el cliente ---
# loopback = cliente y servidor en la misma PC  -> reporta 127.127.127.127
# local    = jugar con gente de tu red local    -> reporta tu IP LAN
# public   = servidor abierto a internet        -> detecta tu IP publica
# tambien acepta una IP o hostname fijo, ej: 190.64.12.34 o mu.midominio.com
RESOLVE_IP=loopback
